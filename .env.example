# Copy this file to .env for local development. NEVER commit .env (it's gitignored).
# On a host (Render/Railway/etc.) set these as environment variables in the dashboard.

# Admin dashboard login token — pick something strong.
ADMIN_TOKEN=change-me

# Resend email API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender + reply-to. For real delivery, verify a domain in Resend and use it here.
MAIL_FROM=CircuitX <onboarding@resend.dev>
MAIL_REPLY_TO=support@devaarambh.com

# Postgres connection string.
# IMPORTANT for IPv4 hosts (Render, most PaaS): use Supabase's SESSION POOLER
# string (Supabase > Project Settings > Database > Connection pooling > Session),
# NOT the direct db.<ref>.supabase.co host (that is often IPv6-only).
# Remember to URL-encode special characters in the password (@ -> %40).
DATABASE_URL=
